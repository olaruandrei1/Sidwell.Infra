# Domain & HTTPS
DOMAIN=yourdomain.com
ACME_EMAIL=your@email.com

# PostgreSQL
POSTGRES_DB=sidwell
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password

# Gemini AI
GEMINI_API_KEY=

# Market data APIs
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
TWELVEDATA_API_KEY=
MARKETAUX_API_KEY=

# Firebase
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# WebPush VAPID  (generare: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourdomain.com

# Broadcasting internal shared secret
BROADCASTING_INTERNAL_SECRET=change-me-random-string

# Django / yfinance adapter
DJANGO_SECRET_KEY=change-me-50-random-chars

# Grafana
GRAFANA_PASSWORD=change-me-strong-password
