{
  "uid": "sidwell-postgres",
  "title": "PostgreSQL",
  "tags": ["sidwell", "database"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    { "id": 100, "type": "row", "title": "Overview",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false },
    {
      "id": 1, "type": "stat", "title": "Active Connections",
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "pg_stat_database_numbackends{datname=\"sidwell\"}", "refId": "A" }]
    },
    {
      "id": 2, "type": "stat", "title": "Cache Hit Ratio (%)",
      "gridPos": { "h": 4, "w": 5, "x": 5, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 90 }, { "color": "green", "value": 98 }] } } },
      "options": { "colorMode": "background" },
      "targets": [{ "expr": "100 * pg_stat_database_blks_hit_total{datname=\"sidwell\"} / (pg_stat_database_blks_hit_total{datname=\"sidwell\"} + pg_stat_database_blks_read_total{datname=\"sidwell\"})", "refId": "A" }]
    },
    {
      "id": 3, "type": "stat", "title": "Database Size",
      "gridPos": { "h": 4, "w": 5, "x": 10, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [{ "expr": "pg_database_size_bytes{datname=\"sidwell\"}", "refId": "A" }]
    },
    {
      "id": 4, "type": "stat", "title": "Deadlocks (total)",
      "gridPos": { "h": 4, "w": 4, "x": 15, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } },
      "options": { "colorMode": "background" },
      "targets": [{ "expr": "pg_stat_database_deadlocks_total{datname=\"sidwell\"}", "refId": "A" }]
    },
    {
      "id": 5, "type": "stat", "title": "Uptime",
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [{ "expr": "time() - pg_postmaster_start_time_seconds", "refId": "A" }]
    },

    { "id": 200, "type": "row", "title": "Transactions & Rows",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }, "collapsed": false },
    {
      "id": 6, "type": "timeseries", "title": "Transactions / sec",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(pg_stat_database_xact_commit_total{datname=\"sidwell\"}[5m])", "legendFormat": "commits", "refId": "A" },
        { "expr": "rate(pg_stat_database_xact_rollback_total{datname=\"sidwell\"}[5m])", "legendFormat": "rollbacks", "refId": "B" }
      ]
    },
    {
      "id": 7, "type": "timeseries", "title": "Row Operations / sec",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(pg_stat_database_tup_returned_total{datname=\"sidwell\"}[5m])", "legendFormat": "returned", "refId": "A" },
        { "expr": "rate(pg_stat_database_tup_fetched_total{datname=\"sidwell\"}[5m])", "legendFormat": "fetched", "refId": "B" },
        { "expr": "rate(pg_stat_database_tup_inserted_total{datname=\"sidwell\"}[5m])", "legendFormat": "inserted", "refId": "C" },
        { "expr": "rate(pg_stat_database_tup_updated_total{datname=\"sidwell\"}[5m])", "legendFormat": "updated", "refId": "D" },
        { "expr": "rate(pg_stat_database_tup_deleted_total{datname=\"sidwell\"}[5m])", "legendFormat": "deleted", "refId": "E" }
      ]
    },

    { "id": 300, "type": "row", "title": "Locks & Contention",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }, "collapsed": false },
    {
      "id": 8, "type": "timeseries", "title": "Locks by Mode",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "pg_locks_count{datname=\"sidwell\"}", "legendFormat": "{{mode}}", "refId": "A" }]
    },
    {
      "id": 9, "type": "timeseries", "title": "Conflicts & Temp Files",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(pg_stat_database_conflicts_total{datname=\"sidwell\"}[5m])", "legendFormat": "conflicts/s", "refId": "A" },
        { "expr": "rate(pg_stat_database_temp_files_total{datname=\"sidwell\"}[5m])", "legendFormat": "temp files/s", "refId": "B" }
      ]
    },

    { "id": 400, "type": "row", "title": "Storage & Cache",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 }, "collapsed": false },
    {
      "id": 10, "type": "timeseries", "title": "Database Size Trend",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [{ "expr": "pg_database_size_bytes{datname=\"sidwell\"}", "legendFormat": "size", "refId": "A" }]
    },
    {
      "id": 11, "type": "timeseries", "title": "Blocks Read vs Hit / sec",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(pg_stat_database_blks_hit_total{datname=\"sidwell\"}[5m])", "legendFormat": "cache hits", "refId": "A" },
        { "expr": "rate(pg_stat_database_blks_read_total{datname=\"sidwell\"}[5m])", "legendFormat": "disk reads", "refId": "B" }
      ]
    },

    { "id": 500, "type": "row", "title": "Container",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 }, "collapsed": false },
    {
      "id": 12, "type": "timeseries", "title": "CPU (%)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "targets": [{ "expr": "rate(container_cpu_usage_seconds_total{name=\"sidwell-postgres\"}[5m]) * 100", "legendFormat": "cpu%", "refId": "A" }]
    },
    {
      "id": 13, "type": "timeseries", "title": "Memory",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [{ "expr": "container_memory_working_set_bytes{name=\"sidwell-postgres\"}", "legendFormat": "working set", "refId": "A" }]
    },
    {
      "id": 14, "type": "timeseries", "title": "Disk I/O",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps" } },
      "targets": [
        { "expr": "rate(container_fs_reads_bytes_total{name=\"sidwell-postgres\"}[5m])", "legendFormat": "read", "refId": "A" },
        { "expr": "rate(container_fs_writes_bytes_total{name=\"sidwell-postgres\"}[5m])", "legendFormat": "write", "refId": "B" }
      ]
    }
  ]
}
